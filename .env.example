# GitHub & Slack integration
API_GITHUB_TOKEN=your_github_token
GITHUB_TARGET_REPO=owner/repo

# Slack notifications
SLACK_WEBHOOK_URL=slack_webhook_url

# AI provider selection for remediation planning
AI_PROVIDER=openai

# OpenAI configuration for AI-assisted remediation
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Anthropic configuration for AI-assisted remediation
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Gemini configuration for AI-assisted remediation
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Remediation defaults
ENABLE_AI_REMEDIATION=true
REMEDIATION_BASE_BRANCH=main
GIT_USER_NAME=CycloGuard Bot
GIT_USER_EMAIL=your-email@example.com

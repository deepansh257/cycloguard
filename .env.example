# Shared local automation credentials for CycloGuard
API_GITHUB_TOKEN=your_github_token
GITHUB_TOKEN=your_github_token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/value
GITHUB_TARGET_REPO=owner/repo

# Remediation defaults
ENABLE_AI_REMEDIATION=false
REMEDIATION_BASE_BRANCH=main
GIT_USER_NAME=CycloGuard Bot
GIT_USER_EMAIL=cycloguard-bot@example.com

# OpenAI configuration for AI-generated remediation planning
OPENAI_API_KEY=your_openai_api_key
API_OPENAI_KEY=your_openai_api_key
OPENAI_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

{
  "name": "cycloguard",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "cbom",
    "sbom",
    "runner"
  ],
  "scripts": {
    "prepare": "node -e \"if(process.platform!=='win32'){require('fs').chmodSync('bin/cycloguard.sh','755')}\"",
    "scan": "node ./bin/cycloguard.js",
    "build": "npm run build --workspaces && npm run build --prefix remediation",
    "remediation:apply": "npm run apply --prefix remediation --"
  },
  "bin": {
    "cycloguard": "./bin/cycloguard.js"
  },
  "devDependencies": {
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}
